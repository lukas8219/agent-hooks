# Read in addition to ~/.gitconfig, which sbx generates and which wins on conflicts.
# Values here make signing work even when the host gitconfig is not merged in.
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGLeu8+wPfdN7EyJY1xE8gBDIkV5YD+5GRT+hQk/SFif
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
